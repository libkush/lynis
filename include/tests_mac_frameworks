#
    APPARMORFOUND=0                     # Set default for test MACF-6208
    MAC_FRAMEWORK_ACTIVE=0              # Default no MAC framework active
    RBAC_FRAMEWORK_ACTIVE=0             # Default no RBAC framework active
    SELINUXFOUND=0
    SELINUX_MODE=""
    TOMOYOFOUND=0

    InsertSection "${SECTION_SECURITY_FRAMEWORKS}"
#
#################################################################################
#
    # Test        : MACF-6204
    # Description : Check if AppArmor is installed
    Register --test-no MACF-6204 --weight L --network NO --category security --description "Check AppArmor presence"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ -z "${AASTATUSBINARY}" ]; then
            APPARMORFOUND=0
            LogText "Result: aa-status binary not found, AppArmor not installed"
            Display --indent 2 --text "- Checking presence AppArmor" --result "${STATUS_NOT_FOUND}" --color WHITE
        else
            APPARMORFOUND=1
            LogText "Result: aa-status binary found, AppArmor is installed"
            Display --indent 2 --text "- Checking presence AppArmor" --result "${STATUS_FOUND}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : MACF-6208
    # Description : Check AppArmor active status
    if [ ${APPARMORFOUND} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MACF-6208 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check if AppArmor is enabled"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ -n "${AASTATUSBINARY}" ]; then
            CAN_READ_FILE=0
            FILE="/sys/kernel/security/apparmor/profiles"
            if [ -f ${FILE} ]; then
                FIND=$(${CAT_BINARY} ${FILE} 2> /dev/null)
                if [ $? -eq 0 ]; then CAN_READ_FILE=1; fi
            else
                LogText "File ${FILE} does not exist"
            fi
            if [ ${CAN_READ_FILE} -eq 1 ]; then
                LogText "Result: file ${FILE} is available and readable"
                # Checking AppArmor status
                # 0 if apparmor is enabled and policy is loaded.
                # 1 if apparmor is not enabled/loaded.
                # 2 if apparmor is enabled but no policy is loaded.
                # 3 if control files are not available
                # 4 if apparmor status can't be read
                FIND=$(${AASTATUSBINARY} 2>&1 > /dev/null)
                if [ $? -eq 0 ]; then
                    MAC_FRAMEWORK_ACTIVE=1
                    LogText "Result: AppArmor is enabled and a policy is loaded"
                    Display --indent 4 --text "- Checking AppArmor status" --result "${STATUS_ENABLED}" --color GREEN
                    Report "apparmor_enabled=1"
                    Report "apparmor_policy_loaded=1"
                    AddHP 3 3
                    # ignore kernel threads (Parent PID = 2 [kthreadd])
                    NUNCONFINED=$(${PSBINARY} -N --ppid 2 -o label | ${GREPBINARY} '^unconfined' | ${WCBINARY} -l)
                    Display --indent 8 --text "Found ${NUNCONFINED} unconfined processes"
                    for PROCESS in $(${PSBINARY} -N --ppid 2 -o label:1,pid,comm | ${GREPBINARY} '^unconfined' | ${TRBINARY} ' ' ':'); do
                        LogText "Result: Unconfined process: ${PROCESS}"
                    done
                elif [ $? -eq 4 ]; then
                    LogText "Result: Can not determine status, most likely due to lacking permissions"
                    Display --indent 4 --text "- Checking AppArmor status" --result "${STATUS_UNKNOWN}" --color RED
                elif [ $? -eq 3 ]; then
                    LogText "Result: Can not check control files"
                    Display --indent 4 --text "- Checking AppArmor status" --result "${STATUS_UNKNOWN}" --color RED
                elif [ $? -eq 2 ]; then
                    LogText "Result: AppArmor is enabled, but no policy is loaded"
                    ReportSuggestion "${TEST_NO}" "Load AppArmor policies"
                    Display --indent 4 --text "- Checking AppArmor status" --result "NON-ACTIVE" --color GREEN
                    Report "apparmor_enabled=1"
                    Report "apparmor_policy_loaded=0"
                    AddHP 0 3
                elif [ $? -eq 1 ]; then
                    LogText "Result: AppArmor is disabled"
                    Display --indent 4 --text "- Checking AppArmor status" --result "${STATUS_DISABLED}" --color YELLOW
                    Report "apparmor_enabled=0"
                    AddHP 0 3
                else
                    Display --indent 4 --text "- Checking AppArmor status" --result "${STATUS_UNKNOWN}" --color RED
                    ReportException "${TEST_NO}:1" "Invalid or unknown AppArmor status detected"
                fi
            else
                LogText "Result: could not find or read ${FILE}"
                Display --indent 4 --text "- Checking AppArmor status" --result "${STATUS_UNKNOWN}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Check output of aa-status" "${FILE}" "text:Run aa-status"
            fi
        else
            LogText "Result: no aa-status binary available"
        fi
    fi
#
#################################################################################
#
    # Test        : MACF-6232
    # Description : Check SELINUX for installation
    Register --test-no MACF-6232 --weight L --network NO --category security --description "Check SELINUX presence"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: checking if we have sestatus binary"
        if [ -n "${SESTATUSBINARY}" ]; then
            LogText "Result: found sestatus binary (${SESTATUSBINARY})"
            Display --indent 2 --text "- Checking presence SELinux" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "Result: sestatus binary NOT found"
            Display --indent 2 --text "- Checking presence SELinux" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : MACF-6234
    # Description : Check SELINUX status
    if HasData "${SESTATUSBINARY}"; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no MACF-6234 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "Check SELINUX status"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Status: Enabled/Disabled
        FIND=$(${SESTATUSBINARY} | ${GREPBINARY} "^SELinux status" | ${AWKBINARY} '{ print $3 }')
        if [ "${FIND}" = "enabled" ]; then
            MAC_FRAMEWORK_ACTIVE=1
            LogText "Result: SELinux framework is enabled"
            Report "selinux_status=1"
            SELINUXFOUND=1
            Display --indent 4 --text "- Checking SELinux status" --result "${STATUS_ENABLED}" --color GREEN
            FIND=$(${SESTATUSBINARY} | ${GREPBINARY} "^Current mode" | ${AWKBINARY} '{ print $3 }')
            SELINUX_MODE="${FIND}"
            Report "selinux_mode=${FIND}"
            FIND2=$(${SESTATUSBINARY} | ${GREPBINARY} "^Mode from config file" | ${AWKBINARY} '{ print $5 }')
            LogText "Result: current SELinux mode is ${FIND}"
            LogText "Result: mode configured in config file is ${FIND2}"
            if [ "${FIND}" = "${FIND2}" ]; then
                LogText "Result: Current SELinux mode is the same as in config file."
                Display --indent 6 --text "- Checking current mode and config file" --result "${STATUS_OK}" --color GREEN
            else
                LogText "Result: Current SELinux mode (${FIND}) is NOT the same as in config file (${FIND2})."
                ReportWarning "${TEST_NO}" "Current SELinux mode is different from config file (current: ${FIND}, config file: ${FIND2})"
                Display --indent 6 --text "- Checking current mode and config file" --result "${STATUS_WARNING}" --color RED
            fi
            Display --indent 8 --text "Current SELinux mode: ${FIND}"
            if [ -n "${SEMANAGEBINARY}" ]; then
                PERMISSIVE=$(${SEMANAGEBINARY} permissive --list --noheading | ${TRBINARY} '\n' ' ')
                NPERMISSIVE=$(${SEMANAGEBINARY} permissive --list --noheading | ${WCBINARY} -l)
                Display --indent 8 --text "Found ${NPERMISSIVE} permissive SELinux object types"
                LogText "Permissive SELinux object types: ${PERMISSIVE}"
            else
                LogText "Result: semanage binary NOT found, can't analyse permissive domains"
            fi
            UNCONFINED=$(${PSBINARY} -eo label,pid,command | ${GREPBINARY} '[u]nconfined_t' | ${TRBINARY} '\n' ' ')
            INITRC=$(${PSBINARY} -eo label,pid,command | ${GREPBINARY} '[i]nitrc_t' | ${TRBINARY} '\n' ' ')
            NUNCONFINED=$(${PSBINARY} -eo label | ${GREPBINARY} '[u]nconfined_t' | ${WCBINARY} -l)
            NINITRC=$(${PSBINARY} -eo label | ${GREPBINARY} '[i]nitrc_t' | ${WCBINARY} -l)
            Display --indent 8 --text "Found ${NUNCONFINED} unconfined and ${NINITRC} initrc_t processes"
            LogText "Unconfined processes: ${UNCONFINED}"
            LogText "Processes with initrc_t type: ${INITRC}"
        else
            LogText "Result: SELinux framework is disabled"
            Display --indent 4 --text "- Checking SELinux status" --result "${STATUS_DISABLED}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    # Test        : MACF-6236
    # Description : Check SELinux confinement of non-loopback TCP/UDP listeners
    PREQS_MET="NO"; SKIPREASON="SELinux is not enabled or ss binary not found"
    if [ ${SELINUXFOUND} -eq 1 -a -n "${SSBINARY}" ]; then PREQS_MET="YES"; SKIPREASON=""; fi
    Register --test-no MACF-6236 --os Linux --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --root-only YES --category security --description "Check SELinux confinement of TCP/UDP listeners"
    if [ ${SKIPTEST} -eq 0 ]; then
        SELINUX_LISTENER_COUNT=0
        SELINUX_LISTENER_CONFINED_COUNT=0
        SELINUX_LISTENER_UNPROTECTED_COUNT=0
        SELINUX_LISTENER_UNKNOWN_COUNT=0
        SELINUX_LISTENER_DETAIL_COUNT=0
        SELINUX_LISTENER_DETAIL_TRUNCATED=0
        SELINUX_LISTENER_CONFINEMENT_PERCENTAGE=-1
        SELINUX_PERMISSIVE_DOMAINS=""

        if [ -n "${SEMANAGEBINARY}" ]; then
            SELINUX_PERMISSIVE_DOMAINS=$(${SEMANAGEBINARY} permissive --list --noheading 2> /dev/null | ${AWKBINARY} '{ print $1 }')
            LogText "Permissive SELinux domains used for listener check: ${SELINUX_PERMISSIVE_DOMAINS}"
        else
            LogText "Result: semanage binary not found, explicitly permissive domains can not be correlated with listeners"
        fi

        CreateTempFile || ExitFatal
        SELINUX_LISTENER_RAW_FILE="${TEMP_FILE}"
        CreateTempFile || ExitFatal
        SELINUX_LISTENER_FILE="${TEMP_FILE}"
        CreateTempFile || ExitFatal
        SELINUX_LISTENER_ERROR_FILE="${TEMP_FILE}"

        LogText "Test: retrieving TCP/UDP listeners and process SELinux contexts with ss"
        ${SSBINARY} --query=udp,tcp -HOnlpZ > ${SELINUX_LISTENER_RAW_FILE} 2> ${SELINUX_LISTENER_ERROR_FILE}
        SELINUX_LISTENER_RESULT=$?
        if [ ${SELINUX_LISTENER_RESULT} -eq 0 ]; then
            ${AWKBINARY} '
                $1 == "tcp" || $1 == "udp" {
                    protocol=$1
                    address=$5
                    process="-"
                    pid="-"
                    context="-"
                    data=$0
                    entry=data
                    sub(/^.*users:\(\("/, "", entry)
                    if (entry != data) {
                        sub(/\),\(".*$/, "", entry)
                        process=entry
                        sub(/".*$/, "", process)
                        value=entry
                        sub(/^.*pid=/, "", value)
                        pid=value
                        sub(/[^0-9].*$/, "", pid)
                        value=entry
                        sub(/^.*proc_ctx=/, "", value)
                        if (value != entry) {
                            context=value
                            sub(/,fd=.*$/, "", context)
                        }
                    }
                    print protocol "|" address "|" process "|" pid "|" context
                }
            ' ${SELINUX_LISTENER_RAW_FILE} > ${SELINUX_LISTENER_FILE}

            while IFS='|' read LISTENER_PROTOCOL LISTENER_ADDRESS LISTENER_PROCESS LISTENER_PID LISTENER_CONTEXT; do
                case ${LISTENER_ADDRESS} in
                    127.*:*|\[::1\]:*|::1:*)
                        LogText "Result: ignoring loopback listener ${LISTENER_PROTOCOL}|${LISTENER_ADDRESS}|${LISTENER_PROCESS}"
                        continue
                    ;;
                esac

                SELINUX_LISTENER_COUNT=$((SELINUX_LISTENER_COUNT + 1))
                LISTENER_DOMAIN=""
                LISTENER_REASON=""
                case ${LISTENER_CONTEXT} in
                    *:*:*) LISTENER_DOMAIN=$(echo "${LISTENER_CONTEXT}" | ${AWKBINARY} -F: '{ print $3 }') ;;
                esac

                if [ -z "${LISTENER_DOMAIN}" ]; then
                    SELINUX_LISTENER_UNKNOWN_COUNT=$((SELINUX_LISTENER_UNKNOWN_COUNT + 1))
                    LogText "Result: no SELinux process context found for listener ${LISTENER_PROTOCOL}|${LISTENER_ADDRESS}|${LISTENER_PROCESS}|${LISTENER_PID}"
                    continue
                fi

                if [ ! "${SELINUX_MODE}" = "enforcing" ]; then
                    LISTENER_REASON="global-permissive"
                else
                    case ${LISTENER_DOMAIN} in
                        unconfined_t|unconfined_service_t) LISTENER_REASON="unconfined-domain" ;;
                        initrc_t)                          LISTENER_REASON="weak-domain" ;;
                    esac
                    if [ -z "${LISTENER_REASON}" ]; then
                        for PERMISSIVE_DOMAIN in ${SELINUX_PERMISSIVE_DOMAINS}; do
                            if [ "${LISTENER_DOMAIN}" = "${PERMISSIVE_DOMAIN}" ]; then
                                LISTENER_REASON="permissive-domain"
                            fi
                        done
                    fi
                fi

                if [ -n "${LISTENER_REASON}" ]; then
                    SELINUX_LISTENER_UNPROTECTED_COUNT=$((SELINUX_LISTENER_UNPROTECTED_COUNT + 1))
                    LogText "Result: unprotected SELinux network listener: ${LISTENER_PROTOCOL}|${LISTENER_ADDRESS}|${LISTENER_PROCESS}|${LISTENER_PID}|${LISTENER_DOMAIN}|${LISTENER_REASON}"
                    if [ ${SELINUX_LISTENER_DETAIL_COUNT} -lt 20 ]; then
                        Report "selinux_unprotected_network_listener[]=${LISTENER_PROTOCOL}|${LISTENER_ADDRESS}|${LISTENER_PROCESS}|${LISTENER_PID}|${LISTENER_DOMAIN}|${LISTENER_REASON}"
                        SELINUX_LISTENER_DETAIL_COUNT=$((SELINUX_LISTENER_DETAIL_COUNT + 1))
                    else
                        SELINUX_LISTENER_DETAIL_TRUNCATED=1
                    fi
                else
                    SELINUX_LISTENER_CONFINED_COUNT=$((SELINUX_LISTENER_CONFINED_COUNT + 1))
                    LogText "Result: confined SELinux network listener: ${LISTENER_PROTOCOL}|${LISTENER_ADDRESS}|${LISTENER_PROCESS}|${LISTENER_PID}|${LISTENER_DOMAIN}"
                fi
            done < ${SELINUX_LISTENER_FILE}

            SELINUX_LISTENER_ATTRIBUTABLE_COUNT=$((SELINUX_LISTENER_CONFINED_COUNT + SELINUX_LISTENER_UNPROTECTED_COUNT))
            if [ ${SELINUX_LISTENER_ATTRIBUTABLE_COUNT} -gt 0 ]; then
                SELINUX_LISTENER_CONFINEMENT_PERCENTAGE=$((SELINUX_LISTENER_CONFINED_COUNT * 100 / SELINUX_LISTENER_ATTRIBUTABLE_COUNT))
            fi

            Report "selinux_network_listener_count=${SELINUX_LISTENER_COUNT}"
            Report "selinux_network_listener_confined_count=${SELINUX_LISTENER_CONFINED_COUNT}"
            Report "selinux_network_listener_unprotected_count=${SELINUX_LISTENER_UNPROTECTED_COUNT}"
            Report "selinux_network_listener_unknown_count=${SELINUX_LISTENER_UNKNOWN_COUNT}"
            Report "selinux_network_listener_confinement_percentage=${SELINUX_LISTENER_CONFINEMENT_PERCENTAGE}"
            Report "selinux_network_listener_detail_truncated=${SELINUX_LISTENER_DETAIL_TRUNCATED}"

            Display --indent 8 --text "Found ${SELINUX_LISTENER_COUNT} non-loopback TCP/UDP listeners"
            if [ ${SELINUX_LISTENER_UNPROTECTED_COUNT} -gt 0 ]; then
                Display --indent 4 --text "- Checking SELinux network listener confinement" --result "${STATUS_SUGGESTION}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Review network services running in unconfined or permissive SELinux domains" "${SELINUX_LISTENER_UNPROTECTED_COUNT} listener(s)" "-"
            elif [ ${SELINUX_LISTENER_UNKNOWN_COUNT} -gt 0 ]; then
                Display --indent 4 --text "- Checking SELinux network listener confinement" --result "${STATUS_UNKNOWN}" --color YELLOW
            else
                Display --indent 4 --text "- Checking SELinux network listener confinement" --result "${STATUS_OK}" --color GREEN
            fi
        else
            SELINUX_LISTENER_ERROR=$(${CAT_BINARY} ${SELINUX_LISTENER_ERROR_FILE} | ${TRBINARY} '\n' ' ')
            LogText "Result: ss could not return SELinux listener contexts (exit code ${SELINUX_LISTENER_RESULT}): ${SELINUX_LISTENER_ERROR}"
            Display --indent 4 --text "- Checking SELinux network listener confinement" --result "${STATUS_UNKNOWN}" --color YELLOW
            ReportException "${TEST_NO}:01" "Could not retrieve SELinux process contexts for TCP/UDP listeners"
        fi
    fi
#
#################################################################################
#
    # Test        : MACF-6238
    # Description : Check TCP/UDP SELinux AVC events since boot
    PREQS_MET="NO"; SKIPREASON="SELinux is not enabled or ausearch binary not found"
    if [ ${SELINUXFOUND} -eq 1 -a -n "${AUSEARCHBINARY}" ]; then PREQS_MET="YES"; SKIPREASON=""; fi
    Register --test-no MACF-6238 --os Linux --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --root-only YES --category security --description "Check TCP/UDP SELinux AVC events since boot"
    if [ ${SKIPTEST} -eq 0 ]; then
        SELINUX_NETWORK_AVC_COUNT=0
        SELINUX_NETWORK_AVC_BLOCKED_COUNT=0
        SELINUX_NETWORK_AVC_PERMISSIVE_COUNT=0
        SELINUX_NETWORK_AVC_UNKNOWN_MODE_COUNT=0
        SELINUX_NETWORK_AVC_DOMAIN_COUNT=0
        SELINUX_NETWORK_AVC_DOMAINS=""
        SELINUX_NETWORK_AVC_DETAIL_COUNT=0
        SELINUX_NETWORK_AVC_DETAIL_TRUNCATED=0

        CreateTempFile || ExitFatal
        SELINUX_NETWORK_AVC_RAW_FILE="${TEMP_FILE}"
        CreateTempFile || ExitFatal
        SELINUX_NETWORK_AVC_FILE="${TEMP_FILE}"
        CreateTempFile || ExitFatal
        SELINUX_NETWORK_AVC_ERROR_FILE="${TEMP_FILE}"

        LogText "Test: querying TCP/UDP SELinux AVC events recorded since boot"
        ${AUSEARCHBINARY} --input-logs --start boot --message AVC,USER_AVC --raw > ${SELINUX_NETWORK_AVC_RAW_FILE} 2> ${SELINUX_NETWORK_AVC_ERROR_FILE}
        SELINUX_NETWORK_AVC_RESULT=$?
        SELINUX_NETWORK_AVC_NO_MATCHES=0
        if [ ${SELINUX_NETWORK_AVC_RESULT} -eq 1 ]; then
            FIND=$(${GREPBINARY} '^<no matches>$' ${SELINUX_NETWORK_AVC_RAW_FILE})
            if [ -n "${FIND}" ]; then
                SELINUX_NETWORK_AVC_NO_MATCHES=1
            elif [ ! -s ${SELINUX_NETWORK_AVC_RAW_FILE} -a ! -s ${SELINUX_NETWORK_AVC_ERROR_FILE} ]; then
                SELINUX_NETWORK_AVC_NO_MATCHES=1
            fi
        fi

        if [ ${SELINUX_NETWORK_AVC_RESULT} -eq 0 -o ${SELINUX_NETWORK_AVC_NO_MATCHES} -eq 1 ]; then
            ${AWKBINARY} '
                function get_value(data, name, value) {
                    value=data
                    sub("^.*" name "=", "", value)
                    if (value == data) return "-"
                    if (substr(value, 1, 1) == "\"") {
                        sub(/^"/, "", value)
                        sub(/".*$/, "", value)
                    } else {
                        sub(/[[:space:]].*$/, "", value)
                    }
                    return value
                }
                /type=(AVC|USER_AVC)/ && /tclass=(tcp_socket|udp_socket)/ {
                    # ausearch --raw terminates each record with ASCII 0x1D (GS);
                    # strip it so the trailing permissive field matches the shell case.
                    gsub(/\035/, "", $0)
                    event=$0
                    sub(/^.*msg=audit\(/, "", event)
                    sub(/\):.*$/, "", event)
                    if (seen[event]++) next
                    class=get_value($0, "tclass")
                    protocol=class
                    sub(/_socket$/, "", protocol)
                    context=get_value($0, "scontext")
                    domain=context
                    sub(/^[^:]*:[^:]*:/, "", domain)
                    sub(/:.*/, "", domain)
                    if (context == "-") domain="-"
                    permission=$0
                    sub(/^.*avc:[[:space:]]*denied[[:space:]]*\{[[:space:]]*/, "", permission)
                    sub(/[[:space:]]*\}.*$/, "", permission)
                    gsub(/[[:space:]]+/, ",", permission)
                    destination=get_value($0, "dest")
                    process=get_value($0, "comm")
                    permissive=get_value($0, "permissive")
                    print protocol "|" domain "|" permission "|" destination "|" permissive "|" process
                }
            ' ${SELINUX_NETWORK_AVC_RAW_FILE} > ${SELINUX_NETWORK_AVC_FILE}

            while IFS='|' read AVC_PROTOCOL AVC_DOMAIN AVC_PERMISSION AVC_DESTINATION AVC_PERMISSIVE AVC_PROCESS; do
                SELINUX_NETWORK_AVC_COUNT=$((SELINUX_NETWORK_AVC_COUNT + 1))
                case ${AVC_PERMISSIVE} in
                    0) SELINUX_NETWORK_AVC_BLOCKED_COUNT=$((SELINUX_NETWORK_AVC_BLOCKED_COUNT + 1)); AVC_MODE="blocked" ;;
                    1) SELINUX_NETWORK_AVC_PERMISSIVE_COUNT=$((SELINUX_NETWORK_AVC_PERMISSIVE_COUNT + 1)); AVC_MODE="permissive" ;;
                    *) SELINUX_NETWORK_AVC_UNKNOWN_MODE_COUNT=$((SELINUX_NETWORK_AVC_UNKNOWN_MODE_COUNT + 1)); AVC_MODE="unknown" ;;
                esac

                case " ${SELINUX_NETWORK_AVC_DOMAINS} " in
                    *" ${AVC_DOMAIN} "*) ;;
                    *)
                        SELINUX_NETWORK_AVC_DOMAINS="${SELINUX_NETWORK_AVC_DOMAINS} ${AVC_DOMAIN}"
                        SELINUX_NETWORK_AVC_DOMAIN_COUNT=$((SELINUX_NETWORK_AVC_DOMAIN_COUNT + 1))
                    ;;
                esac

                LogText "Result: TCP/UDP SELinux AVC event: ${AVC_PROTOCOL}|${AVC_DOMAIN}|${AVC_PERMISSION}|${AVC_DESTINATION}|${AVC_MODE}|${AVC_PROCESS}"
                if [ ${SELINUX_NETWORK_AVC_DETAIL_COUNT} -lt 20 ]; then
                    Report "selinux_network_avc[]=${AVC_PROTOCOL}|${AVC_DOMAIN}|${AVC_PERMISSION}|${AVC_DESTINATION}|${AVC_MODE}|${AVC_PROCESS}"
                    SELINUX_NETWORK_AVC_DETAIL_COUNT=$((SELINUX_NETWORK_AVC_DETAIL_COUNT + 1))
                else
                    SELINUX_NETWORK_AVC_DETAIL_TRUNCATED=1
                fi
            done < ${SELINUX_NETWORK_AVC_FILE}

            Report "selinux_network_avc_period=boot"
            Report "selinux_network_avc_count=${SELINUX_NETWORK_AVC_COUNT}"
            Report "selinux_network_avc_blocked_count=${SELINUX_NETWORK_AVC_BLOCKED_COUNT}"
            Report "selinux_network_avc_permissive_count=${SELINUX_NETWORK_AVC_PERMISSIVE_COUNT}"
            Report "selinux_network_avc_unknown_mode_count=${SELINUX_NETWORK_AVC_UNKNOWN_MODE_COUNT}"
            Report "selinux_network_avc_domain_count=${SELINUX_NETWORK_AVC_DOMAIN_COUNT}"
            Report "selinux_network_avc_detail_truncated=${SELINUX_NETWORK_AVC_DETAIL_TRUNCATED}"

            Display --indent 8 --text "Found ${SELINUX_NETWORK_AVC_COUNT} TCP/UDP SELinux AVC events since boot"
            if [ ${SELINUX_NETWORK_AVC_PERMISSIVE_COUNT} -gt 0 ]; then
                Display --indent 4 --text "- Checking TCP/UDP SELinux AVC events" --result "${STATUS_WARNING}" --color RED
                ReportWarning "${TEST_NO}" "Review network-related SELinux denials that occurred in permissive mode" "${SELINUX_NETWORK_AVC_PERMISSIVE_COUNT} event(s)" "-"
            elif [ ${SELINUX_NETWORK_AVC_BLOCKED_COUNT} -gt 0 -o ${SELINUX_NETWORK_AVC_UNKNOWN_MODE_COUNT} -gt 0 ]; then
                Display --indent 4 --text "- Checking TCP/UDP SELinux AVC events" --result "${STATUS_SUGGESTION}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "Review network-related SELinux denials" "${SELINUX_NETWORK_AVC_COUNT} event(s) since boot" "-"
            else
                Display --indent 4 --text "- Checking TCP/UDP SELinux AVC events" --result "${STATUS_OK}" --color GREEN
            fi
        else
            SELINUX_NETWORK_AVC_ERROR=$(${CAT_BINARY} ${SELINUX_NETWORK_AVC_ERROR_FILE} | ${TRBINARY} '\n' ' ')
            LogText "Result: ausearch could not query SELinux AVC events (exit code ${SELINUX_NETWORK_AVC_RESULT}): ${SELINUX_NETWORK_AVC_ERROR}"
            Display --indent 4 --text "- Checking TCP/UDP SELinux AVC events" --result "${STATUS_UNKNOWN}" --color YELLOW
            ReportException "${TEST_NO}:01" "Could not query SELinux AVC events from the audit log"
        fi
    fi
#
#################################################################################
#
    # Test        : MACF-6240
    # Description : Check if the tomoyo-init binary is available on the system
    Register --test-no MACF-6240 --weight L --network NO --category security --description "Check TOMOYO Linux presence"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "Test: checking if we have tomoyo-init binary"
        if [ -z "${TOMOYOINITBINARY}" ]; then
            TOMOYOFOUND=0
            LogText "Result: tomoyo-init binary not found"
